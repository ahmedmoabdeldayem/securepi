[Unit]
Description=Measure firmware-verified boot state into TPM PCR 8
DefaultDependencies=no
After=dev-tpmrm0.device
Requires=dev-tpmrm0.device
Before=tpm-luks-unlock.service local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/securepi/tpm-measure-boot.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=local-fs.target

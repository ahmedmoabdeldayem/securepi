# securepi-logger file contexts
# setfiles uses these at image creation time to stamp labels onto files.
# Each entry maps a path regex to an SELinux label.
# -- means regular file only (not directories or symlinks).

/usr/bin/securepi-logger        --      system_u:object_r:securepi_logger_exec_t:s0
/etc/securepi-logger\.conf      --      system_u:object_r:securepi_logger_conf_t:s0
/run/securepi-logger/securepi-logger\.log       --      system_u:object_r:securepi_logger_log_t:s0

# LUKS data partition mount point: labeled var_run_t so confined daemons
# that read secrets from the encrypted volume get a consistent label.
/run/securedata(/.*)?                                   system_u:object_r:var_run_t:s0

# TPM character devices: created at boot by tpm_tis_spi when the chip probes.
# /dev/tpm0    = direct access (one process at a time, no multiplexing)
# /dev/tpmrm0  = in-kernel resource manager (kernel 4.20+, multiplexed access)
# tpm_device_t is defined in refpolicy; explicit entries here ensure labeling
# even if the refpolicy file_contexts are missing or outdated.
/dev/tpm[0-9]+                  -c      system_u:object_r:tpm_device_t:s0
/dev/tpmrm[0-9]+                -c      system_u:object_r:tpm_device_t:s0

policy_module(securepi, 1.0.0)

########################################
# SecurePi custom SELinux policy
#
# This file is populated from first-boot AVC denials using audit2allow.
# Workflow:
#   1. Boot in permissive mode (DEFAULT_ENFORCING = "permissive" in securepi.conf)
#   2. Collect denials: dmesg | grep "avc:" > /tmp/avc.log
#   3. Run on Pi: audit2allow -i /tmp/avc.log -m securepi >> securepi.te
#   4. Rebuild image with this file updated, test in enforcing mode
#
# The module declaration above is required: without it checkmodule rejects the file.
# Rules go below as they are derived from the audit log.
########################################

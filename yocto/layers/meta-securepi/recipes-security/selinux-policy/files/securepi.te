module securepi 1.17.0;

require {
    type kernel_t;
    type init_t;
    type mount_t;
    type initrc_runtime_t;
    type var_spool_t;
    type lib_t;
    type ld_so_t;
    type ld_so_cache_t;
    type proc_t;
    type var_run_t;
    type tmpfs_t;
    role system_r;
    attribute domain;
    attribute daemon;
    type lvm_t;
    type klogd_t;
    type syslogd_t;
    type bpf_t;
    type removable_device_t;
    type bin_t;
    type local_login_t;
    type urandom_device_t;
    type tpm_device_t;
    type system_dbusd_t;
    type syslogd_runtime_t;
    class capability2 { audit_read };
    class file { execute entrypoint read open getattr map lock ioctl write create append };
    class blk_file { getattr read open write ioctl lock };
    class chr_file { read open getattr write ioctl };
    class sock_file { write };
    class dir { mounton search write add_name };
    class key { search };
    class process { transition };
    class lnk_file { read getattr };
    class fd { use };
    class filesystem { associate };
}

########################################
# kernel_t: early-boot systemd
#
# systemd starts as kernel_t before SELinux transitions it to init_t.
# During that window it reads the audit log: CAP_AUDIT_READ (cap 37),
# which lives in capability2 (caps 32-63).
########################################
allow kernel_t self:capability2 audit_read;

# mount_t is denied mounton on var_spool_t when systemd sets up the tmpfs
# overlay for /var/spool at boot. Refpolicy is missing this specific permission.
allow mount_t var_spool_t:dir mounton;

# mount_t is denied mounton on /run/securedata (initrc_runtime_t) when the
# tpm-luks-unlock service mounts the LUKS-decrypted partition at boot.
allow mount_t initrc_runtime_t:dir mounton;

########################################
# securepi-logger: confined telemetry service
#
# Intentionally minimal: only the domain transition is defined here.
# All other permissions are derived from the AVC denial log after first boot
# in permissive mode, then added below.
########################################
type securepi_logger_t;
type securepi_logger_exec_t;
type securepi_logger_conf_t;
type securepi_logger_log_t;

# securepi_logger_t must be in the 'domain' attribute or the refpolicy neverallow
# "neverallow * ~domain:process { transition }" rejects our transition rule.
# It must be in 'daemon' or "neverallow init_t ~daemon:process { transition }"
# rejects init_t starting it.
typeattribute securepi_logger_t domain;
typeattribute securepi_logger_t daemon;

role system_r types securepi_logger_t;

# Entry point: the binary is the gate into this domain
allow securepi_logger_t securepi_logger_exec_t:file entrypoint;

# After the domain transition the dynamic linker needs to read and map the
# binary's own code sections. Without these the linker silently fails and the
# process crashes with SIGSEGV. These mirror refpolicy's domain_entry_file().
allow securepi_logger_t securepi_logger_exec_t:file { read open getattr execute map lock ioctl };

# The 'domain' attribute provides execute/read/open/getattr on lib_t and ld_so_t
# but NOT map. 'map' was added as a separate SELinux permission in kernel 4.18+
# and refpolicy's domain attribute was never updated for it. Without map,
# mmap(PROT_EXEC) is silently denied (dontaudit suppresses the AVC), crashing
# the dynamic linker with SIGSEGV before main() is reached.
allow securepi_logger_t lib_t:file map;
allow securepi_logger_t lib_t:dir search;
allow securepi_logger_t lib_t:lnk_file { read getattr };
allow securepi_logger_t ld_so_t:file map;
allow securepi_logger_t ld_so_cache_t:file map;

# Config file: /etc/securepi-logger.conf (labeled securepi_logger_conf_t by setfiles)
allow securepi_logger_t securepi_logger_conf_t:file { read open getattr };

# /proc/uptime is proc_t; 'domain' may not cover all proc reads for confined daemons
allow securepi_logger_t proc_t:file { read open getattr };

# Log file in /run/: /run is a tmpfs so setfiles never labels it at build time.
# type_transition labels newly created files so the write rules below actually match.
allow securepi_logger_t var_run_t:dir { search write add_name };
allow securepi_logger_t securepi_logger_log_t:file { create write open append getattr };
type_transition securepi_logger_t var_run_t:file securepi_logger_log_t "securepi-logger.log";
# securepi_logger_log_t files live on /run/ which is tmpfs_t; without this
# the kernel rejects file creation with EACCES (filesystem:associate check).
allow securepi_logger_log_t tmpfs_t:filesystem associate;

# init_t executes the binary and transitions into securepi_logger_t
allow init_t securepi_logger_exec_t:file { execute read open getattr };
allow init_t securepi_logger_t:process transition;
type_transition init_t securepi_logger_exec_t:process securepi_logger_t;

########################################
# dm-crypt (cryptsetup / device-mapper)
#
# cryptsetup delegates block device setup to device-mapper, which runs as lvm_t.
# lvm_t needs to write the LUKS header to the SD card partition (removable_device_t),
# search the BPF filesystem that dm-crypt probes during initialisation, and search
# init_t's kernel keyring (used by dm-crypt for key retention).
########################################
allow lvm_t removable_device_t:blk_file { getattr ioctl lock read open write };
allow lvm_t bpf_t:dir search;
allow lvm_t init_t:key search;

########################################
# System daemon map permission fixes
#
# klogd and syslogd need mmap(PROT_EXEC) on binaries in /bin to load shared
# libraries at startup. Same root cause as securepi_logger_t above:
# refpolicy's domain attribute provides execute/read on bin_t but not map.
########################################
allow klogd_t bin_t:file { read open execute map };
allow syslogd_t bin_t:file { read open execute map };

# After domain transition, the new process inherits open FDs from systemd (init_t).
# The dynamic linker reads the binary through the inherited exec-fd, and systemd
# passes stdin/stdout/stderr and its notification socket. Without fd:use, every
# operation on those inherited FDs fails with EACCES → SIGSEGV in the dynamic linker.
allow securepi_logger_t init_t:fd use;

########################################
# D-Bus syslog socket
#
# dbus-daemon is denied write on /dev/log (syslogd_runtime_t:sock_file).
# This causes D-Bus to retry logging with a timeout on every attempt,
# visibly slowing down serial login (PAM + systemd-logind use D-Bus).
########################################
allow system_dbusd_t syslogd_runtime_t:sock_file write;

# Same mislabelled socket (/run/systemd/journal/dev-log inherits syslogd_runtime_t
# from its directory): login could not log the serial-console logins.
allow local_login_t syslogd_runtime_t:sock_file write;

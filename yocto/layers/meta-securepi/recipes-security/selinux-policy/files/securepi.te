module securepi 1.0.1;

# Types and classes defined in refpolicy that this module references.
# Any type/class not defined in THIS module must be declared here.
require {
    type kernel_t;
    class capability2 { audit_read };
}

########################################
# kernel_t: early-boot systemd
#
# systemd starts as kernel_t before SELinux transitions it to init_t.
# During that window it reads the audit log: capability 37 (CAP_AUDIT_READ),
# which lives in the capability2 class (caps 32-63).
########################################
allow kernel_t self:capability2 audit_read;
